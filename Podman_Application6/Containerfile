# Hafif resmi Python imajı
FROM python:3.12-slim

# Çevresel değişkenler
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_NAME="Podman Demo API" \
    APP_PORT=5000 \
    APP_ENV=production

# Çalışma dizini
WORKDIR /app

# Önce bağımlılıkları kopyala (layer cache için)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Uygulama kodunu kopyala
COPY app.py .

# Root olmayan kullanıcı oluştur ve geçiş yap (güvenlik)
RUN useradd --create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app
USER appuser

# Dinlenen port
EXPOSE 5000

# Healthcheck - /health endpoint'ini kontrol eder
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; \
sys.exit(0) if urllib.request.urlopen('http://localhost:5000/health').status==200 else sys.exit(1)"

# Gunicorn ile çalıştır (production-ready)
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--access-logfile", "-", "app:app"]	
